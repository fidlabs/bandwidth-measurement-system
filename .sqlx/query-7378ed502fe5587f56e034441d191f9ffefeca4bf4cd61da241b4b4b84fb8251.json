  "query": "\n            SELECT\n                id,\n                job_id,\n                status as \"status: SubJobStatus\",\n                type as \"type: SubJobType\",\n                details,\n                deadline_at\n            FROM sub_jobs\n            WHERE job_id = $1\n              AND type = $2\n              AND status = $3\n            ",
