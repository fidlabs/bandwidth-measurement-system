{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, name, provider_type as \"provider_type!: ProviderType\", details, is_enabled, location, descale_at\n            FROM services as s\n            JOIN service_topics as st ON s.id = st.service_id\n            WHERE st.topic_id = (\n                SELECT id FROM topics WHERE name = $1\n            ) AND s.is_enabled = TRUE\n            ",
